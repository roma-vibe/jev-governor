{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "allowImportingTsExtensions": true
  },
  "include": [
    ".claude/types",
    "hooks",
    "tests"
  ],
  "exclude": [
    "tests/projects.test.ts",
    "tests/i18n.test.ts"
  ]
}
